# MongoDB Atlas (or local mongodb://127.0.0.1:27017)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGO_DB_NAME=fleetflow

# Email — SendGrid (recommended for OTP / password reset)
SENDGRID_API_KEY=
# Must match a verified sender in SendGrid → Settings → Sender Authentication
DEFAULT_FROM_EMAIL=you@yourdomain.com

# Force console-only email (prints to runserver terminal, nothing in inbox)
# EMAIL_CONSOLE=true

# Optional: only when DEBUG=True and you must debug TLS locally
# MONGO_TLS_ALLOW_INVALID=true

# Stripe (optional — omit to allow trial without payment when BILLING_ENFORCE=false)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# BILLING_ENFORCE=false
# BILLING_ALLOW_TRIAL_WITHOUT_PAYMENT=true

# Platform admin bootstrap (manage.py create_platform_admin)
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=

